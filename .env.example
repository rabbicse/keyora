# Keyora configuration. Copy to .env and adjust; every value shown is the default
# unless marked otherwise. Keyora reads the process environment, so load the file
# with your process manager, `docker run --env-file .env`, or:  set -a; . ./.env; set +a

# ---- Required in practice ----------------------------------------------------
# Root management credential (at least 32 characters). Without it, tenants cannot
# be created through the API. Generate one with:  openssl rand -hex 32
KEYORA_ADMIN_KEY=

# Public base URL of this Keyora. It becomes the "iss" claim of every token, so
# changing it later invalidates tokens already issued. Use https in production.
KEYORA_ISSUER=http://localhost:8080

# ---- HTTP --------------------------------------------------------------------
KEYORA_HTTP_ADDR=:8080
KEYORA_HTTP_READ_TIMEOUT=15s
KEYORA_HTTP_WRITE_TIMEOUT=30s
KEYORA_HTTP_IDLE_TIMEOUT=120s
KEYORA_SHUTDOWN_TIMEOUT=20s
# Set to true only behind a reverse proxy you control. Keyora then takes the
# client address from the right-most X-Forwarded-For entry.
KEYORA_TRUST_PROXY_HEADERS=false
# Extra browser origins allowed by CORS (comma separated). Origins registered on
# applications are allowed automatically.
KEYORA_CORS_ALLOWED_ORIGINS=

# ---- Database ----------------------------------------------------------------
# sqlite | postgres | memory (memory loses all data on exit; development only)
KEYORA_DB_DRIVER=sqlite
# sqlite:   file:./data/keyora.db
# postgres: postgres://user:password@host:5432/keyora?sslmode=verify-full
KEYORA_DB_DSN=file:./data/keyora.db
KEYORA_DB_MAX_OPEN_CONNS=20
KEYORA_DB_MAX_IDLE_CONNS=5
KEYORA_DB_CONN_MAX_LIFETIME=30m
# Set to true when the DSN points at PgBouncer (or another pooler) in transaction
# pooling mode. Keyora then avoids named prepared statements.
KEYORA_DB_PGBOUNCER=false
# Apply pending migrations on startup. Set to false to run `keyora migrate` yourself.
KEYORA_AUTO_MIGRATE=true

# ---- Signing keys ------------------------------------------------------------
# Directory of RSA private keys (*.pem). A first key is generated if it is empty.
# Back this directory up and keep it private.
KEYORA_KEYS_DIR=./data/keys
KEYORA_RSA_BITS=3072

# ---- Tokens and sessions -----------------------------------------------------
# Defaults for new applications; each application can override them.
KEYORA_ACCESS_TOKEN_TTL=15m
KEYORA_REFRESH_TOKEN_TTL=720h

# ---- Passwords and brute-force protection -----------------------------------
KEYORA_PASSWORD_MIN_LENGTH=8
KEYORA_PBKDF2_ITERATIONS=600000
KEYORA_MAX_FAILED_LOGINS=5
KEYORA_LOCKOUT_DURATION=15m
# Per client IP, on /api/v1/auth/* and /api/v1/oauth/*. 0 disables the limiter.
KEYORA_RATE_LIMIT_PER_MINUTE=60
KEYORA_RATE_LIMIT_BURST=20

# ---- Tutorial compatibility (migration only; see docs/legacy-tutorial-api.md) ----
# Serves the original auth-tutorial endpoints, including its challenge-response
# login, whose stored verifiers are password-equivalent. Off by default.
KEYORA_LEGACY_TUTORIAL_API=false
# client_id of the confidential application legacy users belong to.
KEYORA_LEGACY_TUTORIAL_CLIENT_ID=

# ---- Email -------------------------------------------------------------------
# log  = write emails (including tokens) to the log; development only
# smtp = send through the relay below
KEYORA_MAILER=log
KEYORA_SMTP_HOST=
KEYORA_SMTP_PORT=587
KEYORA_SMTP_USERNAME=
KEYORA_SMTP_PASSWORD=
KEYORA_SMTP_FROM=
# Refuse sign-in until the email address is verified.
KEYORA_REQUIRE_EMAIL_VERIFICATION=false
# Links placed in emails; {token} is replaced. Left empty, emails carry the bare token.
# Example: https://app.example.com/verify-email?token={token}
KEYORA_EMAIL_VERIFICATION_URL=
KEYORA_PASSWORD_RESET_URL=

# ---- Transports --------------------------------------------------------------
# REST is always served on KEYORA_HTTP_ADDR. GraphQL shares that listener.
KEYORA_GRAPHQL_ENABLED=true
# Lets clients query the GraphQL schema itself. The schema is public either way.
KEYORA_GRAPHQL_INTROSPECTION=true
# Listen address of the gRPC API. Empty disables it. Plaintext: put it behind
# the same TLS-terminating proxy as the HTTP listener.
KEYORA_GRPC_ADDR=
# gRPC server reflection (lets generic tools list services).
KEYORA_GRPC_REFLECTION=true

# ---- Observability -----------------------------------------------------------
KEYORA_LOG_LEVEL=info
# json | text
KEYORA_LOG_FORMAT=json
# Serves Prometheus metrics at /metrics (unauthenticated: restrict at the proxy).
KEYORA_METRICS_ENABLED=true
